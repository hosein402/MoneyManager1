<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_installment"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etInstallmentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/installment_title_hint"
        android:inputType="text"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etInstallmentAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/installment_amount_hint"
        android:inputType="number"
        android:textDirection="ltr"
        android:gravity="end"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etInstallmentCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/installment_count_hint"
        android:inputType="number"
        android:textDirection="ltr"
        android:gravity="end"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSaveInstallment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:text="@string/save" />

        <Button
            android:id="@+id/btnCancelInstallment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/cancel" />
    </LinearLayout>

</LinearLayout>
