<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/security_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvPinStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvFingerprintStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnEnablePin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:text="@string/enable_pin"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnChangePin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/card_background"
        android:textColor="@color/text_primary"
        android:text="@string/change_pin"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnToggleFingerprint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/card_background"
        android:textColor="@color/text_primary"
        android:text="@string/enable_fingerprint"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnDisablePin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/expense_red"
        android:textColor="@color/white"
        android:text="@string/disable_pin" />

</LinearLayout>
